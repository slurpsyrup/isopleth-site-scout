/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://stats.isopleth.dev https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https://basemap.nationalmap.gov; connect-src 'self' https://stats.isopleth.dev https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
